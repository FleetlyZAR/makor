---
import Base from '../../layouts/Base.astro';
import VerseText from '../../components/VerseText.astro';
import AppAudioPlayer from '../../components/AppAudioPlayer.astro';
import { getAllStudies, bookSlug } from '../../lib/studies.js';

export function getStaticPaths() {
  return getAllStudies().map((study) => ({
    params: { book: bookSlug(study.book), slug: study.section.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const sec = study.section ?? {};
const s = study.study ?? {};
const basic = s.basic ?? {};
const lex = study.lexicon ?? {};
const units = study.text?.units ?? [];
const ctx = s.context ?? {};
const herm = s.hermeneutics ?? {};
const quiz = study.quiz ?? [];
const smedia = s.media ?? {};

const siblings = getAllStudies()
  .filter((x) => x.book === study.book)
  .sort((a, b) => (a.section?.order ?? 0) - (b.section?.order ?? 0));
const idx = siblings.findIndex((x) => x.section?.slug === sec.slug);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;
const bslug = bookSlug(study.book);
---
<Base title={`${sec.title} | Makor`} description={sec.thesis}>
  <AppAudioPlayer book={study.book} bookSlug={bslug} slug={sec.slug} title={sec.title} />

  <section class="hero">
    <p class="eyebrow">{study.book}</p>
    <h1>{sec.title}</h1>
    <p class="ref">{sec.passageRef}</p>
    {sec.thesis && <p class="thesis">{sec.thesis}</p>}
  </section>

  {sec.sectionRationale && (
    <div class="rationale"><strong>Why this section</strong>{sec.sectionRationale}</div>
  )}
  {sec.frameNote && (
    <div class="rationale"><strong>Structure</strong>{sec.frameNote}</div>
  )}

  <div id="study-meta" data-slug={sec.slug} data-book={study.book} data-title={sec.title} hidden></div>

  <div class="mkshare" id="mkshare" hidden role="dialog" aria-label="Share verse">
    <span class="mkshare-ref" id="mkshare-ref"></span>
    <button class="mkshare-btn" id="mkshare-share" type="button">Share</button>
    <button class="mkshare-btn" id="mkshare-copy" type="button">Copy</button>
    <button class="mkshare-x" id="mkshare-close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
    </button>
  </div>

  <!-- Step 1: read the passage -->
  <p class="step-label">Step 1. Read the passage</p>
  <details class="cascade" open>
    <summary><span class="cascade-title">The passage</span><span class="cascade-ref">{sec.passageRef}</span><span class="chev" aria-hidden="true"></span></summary>
    <div class="cascade-body">
      <div class="scripture">
        {units.map((u) => (
          <div class="unit">
            {u.label && <div class="unit-label">{u.label}{u.note && <span class="unit-note"> &nbsp; {u.note}</span>}</div>}
            <p>{u.verses?.map((v) => <VerseText verse={v} lexicon={lex} book={study.book} />)}</p>
            {u.media && u.media.kind === 'image' && (
              <figure class="media"><img src={u.media.src} alt={u.media.alt || ''} loading="lazy" />{u.media.caption && <figcaption>{u.media.caption}</figcaption>}</figure>
            )}
            {u.media && u.media.kind === 'youtube' && (
              <figure class="media"><div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${u.media.youtubeId}`} title={u.media.caption || 'Video'} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>{u.media.caption && <figcaption>{u.media.caption}</figcaption>}</figure>
            )}
          </div>
        ))}
      </div>
    </div>
  </details>

  <!-- Step 2: pre-test (answers lock, opens the study) -->
  {quiz.length > 0 && (
    <section class="assess" id="pretest">
      <p class="step-label">Step 2. Answer first, before the study</p>
      <p class="assess-intro">Give your best answer to each. Your answers lock once chosen, so this is an honest first attempt. You will answer the same questions again after the study to see what changed.</p>
      <div class="quiz">
        {quiz.map((item, qi) => (
          <div class="quiz-q" data-answered="0">
            <p class="quiz-question">{qi + 1}. {item.q}</p>
            <div class="quiz-options">
              {(item.options ?? []).map((o) => (
                <button class="quiz-opt" type="button" data-weight={o.weight} data-note={o.note}><span class="opt-letter" aria-hidden="true"></span>
                  <span class="opt-text">{o.text}</span>
                  <span class="opt-badge" aria-hidden="true"></span>
                </button>
              ))}
            </div>
            <p class="quiz-feedback" hidden></p>
          </div>
        ))}
      </div>
      <p class="quiz-score" hidden>First score: <span class="quiz-score-val">0</span>% <span class="quiz-score-meta"></span></p>
      <button class="open-study" id="open-study" type="button" hidden>Open the study</button>
    </section>
  )}

  <!-- Step 3: the study (revealed after the pre-test) -->
  <div id="study-gate" class:list={[quiz.length > 0 ? 'gated' : '']} hidden={quiz.length > 0}>
    <p class="step-label">Step 3. Study the passage</p>

    <details class="cascade">
      <summary><span class="cascade-title">Context</span><span class="chev" aria-hidden="true"></span></summary>
      <div class="cascade-body">
        {basic.context && <p class="level-basic">{basic.context}</p>}
        {(ctx.literary || ctx.historical || ctx.canonical) && (
          <>
            <button class="go-deeper" type="button">Go deeper</button>
            <div class="level-advanced" hidden>
              {ctx.literary && (<><h3>Literary</h3><p>{ctx.literary}</p></>)}
              {ctx.historical && (<><h3>Historical</h3><p>{ctx.historical}</p></>)}
              {ctx.canonical && (<><h3>Canonical</h3><p>{ctx.canonical}</p></>)}
            </div>
          </>
        )}
      </div>
    </details>

    <details class="cascade">
      <summary><span class="cascade-title">Reading it rightly</span><span class="chev" aria-hidden="true"></span></summary>
      <div class="cascade-body">
        {basic.hermeneutics && <p class="level-basic">{basic.hermeneutics}</p>}
        {(herm.authorIntent || herm.descriptionVsPrescription || (herm.debates ?? []).length > 0) && (
          <>
            <button class="go-deeper" type="button">Go deeper</button>
            <div class="level-advanced" hidden>
              {herm.authorIntent && (<><h3>Author's intent</h3><p>{herm.authorIntent}</p></>)}
              {herm.descriptionVsPrescription && (<><h3>Description and prescription</h3><p>{herm.descriptionVsPrescription}</p></>)}
              {(herm.debates ?? []).length > 0 && <h3>Debates</h3>}
              {(herm.debates ?? []).map((d) => (
                <div class="debate">
                  <p class="q">{d.question}</p>
                  <ul class="pairlist">
                    {(d.views ?? []).map((v) => (<li><span class="k">{v.label}:</span> {v.case}</li>))}
                  </ul>
                  {d.bearing && <p><em>{d.bearing}</em></p>}
                </div>
              ))}
            </div>
          </>
        )}
      </div>
    </details>

    {(basic.originalLanguages || s.originalLanguages || Object.keys(lex).length > 0) && (
      <details class="cascade">
        <summary><span class="cascade-title">The original languages</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          {basic.originalLanguages && <p class="level-basic">{basic.originalLanguages}</p>}
          {(s.originalLanguages || Object.keys(lex).length > 0) && (
            <>
              <button class="go-deeper" type="button">Go deeper</button>
              <div class="level-advanced" hidden>
                {s.originalLanguages && <p>{s.originalLanguages}</p>}
                {Object.keys(lex).length > 0 && (
                  <dl class="glossary">
                    {Object.values(lex).map((e) => (
                      <div>
                        <dt>{e.lemma} {e.original && <span class="orig">{e.original}</span>} <span class="lang">({e.language})</span></dt>
                        <dd>{e.gloss}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
            </>
          )}
        </div>
      </details>
    )}

    {(basic.typology || (s.typology ?? []).length > 0) && (
      <details class="cascade">
        <summary><span class="cascade-title">Types and shadows</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          {basic.typology && <p class="level-basic">{basic.typology}</p>}
          {(s.typology ?? []).length > 0 && (
            <>
              <button class="go-deeper" type="button">Go deeper</button>
              <div class="level-advanced" hidden>
                <ul class="pairlist">
                  {s.typology.map((t) => (<li><span class="k">{t.type}:</span> {t.fulfillment}</li>))}
                </ul>
              </div>
            </>
          )}
        </div>
      </details>
    )}

    {(basic.christ || s.christ) && (
      <details class="cascade">
        <summary><span class="cascade-title">Christ as the point</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          {basic.christ && <p class="level-basic">{basic.christ}</p>}
          {s.christ && (<><button class="go-deeper" type="button">Go deeper</button><div class="level-advanced" hidden><p>{s.christ}</p></div></>)}
        </div>
      </details>
    )}

    {(basic.god || s.god) && (
      <details class="cascade">
        <summary><span class="cascade-title">What we learn about God</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          {basic.god && <p class="level-basic">{basic.god}</p>}
          {s.god && (<><button class="go-deeper" type="button">Go deeper</button><div class="level-advanced" hidden><p>{s.god}</p></div></>)}
        </div>
      </details>
    )}

    {(basic.crossReferences || (s.crossReferences ?? []).length > 0) && (
      <details class="cascade">
        <summary><span class="cascade-title">Cross references</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          {basic.crossReferences && <p class="level-basic">{basic.crossReferences}</p>}
          {(s.crossReferences ?? []).length > 0 && (
            <>
              <button class="go-deeper" type="button">Go deeper</button>
              <div class="level-advanced" hidden>
                <ul class="pairlist">
                  {s.crossReferences.map((c) => (<li><span class="k">{c.ref}:</span> {c.note}</li>))}
                </ul>
              </div>
            </>
          )}
        </div>
      </details>
    )}

    {(basic.oneStory || s.oneStory) && (
      <details class="cascade">
        <summary><span class="cascade-title">The one story</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          {smedia.oneStory && smedia.oneStory.kind === 'youtube' && (
            <figure class="media"><div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${smedia.oneStory.youtubeId}`} title={smedia.oneStory.caption || 'Video'} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>{smedia.oneStory.caption && <figcaption>{smedia.oneStory.caption}</figcaption>}</figure>
          )}
          {basic.oneStory && <p class="level-basic">{basic.oneStory}</p>}
          {s.oneStory && (<><button class="go-deeper" type="button">Go deeper</button><div class="level-advanced" hidden><p>{s.oneStory}</p></div></>)}
        </div>
      </details>
    )}

    {(study.translationNotes ?? []).length > 0 && (
      <details class="cascade">
        <summary><span class="cascade-title">Translation notes</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          <ul class="pairlist">
            {study.translationNotes.map((n) => (<li><span class="k">{n.ref}:</span> {n.note}</li>))}
          </ul>
        </div>
      </details>
    )}

    <!-- Step 4: post-test -->
    {quiz.length > 0 && (
      <section class="assess" id="posttest">
        <p class="step-label">Step 4. Answer again, after the study</p>
        <p class="assess-intro">The same questions. See how your understanding has grown.</p>
        <div class="quiz">
          {quiz.map((item, qi) => (
            <div class="quiz-q" data-answered="0">
              <p class="quiz-question">{qi + 1}. {item.q}</p>
              <div class="quiz-options">
                {(item.options ?? []).map((o) => (
                  <button class="quiz-opt" type="button" data-weight={o.weight} data-note={o.note}><span class="opt-letter" aria-hidden="true"></span>
                    <span class="opt-text">{o.text}</span>
                    <span class="opt-badge" aria-hidden="true"></span>
                  </button>
                ))}
              </div>
              <p class="quiz-feedback" hidden></p>
            </div>
          ))}
        </div>
        <p class="quiz-score" hidden>Second score: <span class="quiz-score-val">0</span>% <span class="quiz-score-meta"></span></p>
      </section>
    )}

    <!-- Result comparison -->
    <div class="compare" id="compare" hidden>
      <p class="compare-head">What changed today</p>
      <p class="compare-line">Before the study: <span id="pre-out">0</span>%. After the study: <span id="post-out">0</span>%.</p>
      <p class="compare-msg" id="compare-msg"></p>
      <p class="compare-save" id="compare-save"></p>
    </div>

    <div class="history" id="history" hidden>
      <p class="history-head">Your history for this study</p>
      <ul class="history-list" id="history-list"></ul>
    </div>

    <!-- Questions for reflection -->
    {(study.questions ?? []).length > 0 && (
      <details class="cascade reflect-section">
        <summary><span class="cascade-title">Questions for reflection</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          <ol class="reflect">
            {study.questions.map((q) => (<li>{q}</li>))}
          </ol>
        </div>
      </details>
    )}

    <!-- Sermon (verified), after the reflection questions -->
    {s.sermon && s.sermon.status === 'verified' && (
      <details class="cascade">
        <summary><span class="cascade-title">Listen further</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="cascade-body">
          <div class="sermon">
            <p><strong>{s.sermon.preacher}</strong>: {s.sermon.title}</p>
            {s.sermon.url && <p><a href={s.sermon.url} target="_blank" rel="noopener">Open the sermon</a></p>}
            {s.sermon.why && <p>{s.sermon.why}</p>}
          </div>
        </div>
      </details>
    )}
  </div>

  <nav class="study-nav">
    {prev
      ? <a class="nav-prev" href={`/${bslug}/${prev.section.slug}/`}><span class="nav-dir">Previous study</span><span class="nav-title">{prev.section.title}</span></a>
      : <span class="nav-prev nav-empty"></span>}
    <a class="nav-home" href="/">Back to all books</a>
    {next
      ? <a class="nav-next" href={`/${bslug}/${next.section.slug}/`}><span class="nav-dir">Next study</span><span class="nav-title">{next.section.title}</span></a>
      : <span class="nav-next nav-empty"></span>}
  </nav>
</Base>

<style is:global>
  .scripture .verse { scroll-margin-top: 7rem; border-radius: 5px; cursor: pointer; transition: background-color .25s ease; padding: 0 2px; }
  .scripture .verse:hover { background: var(--light-soft); }
  .scripture .verse.selected { background: var(--light-soft); box-shadow: 0 0 0 2px var(--light-soft); }
  .scripture .verse.flash { animation: mkflash 1.8s ease; }
  @keyframes mkflash { 0%, 100% { background: transparent; } 25%, 65% { background: var(--light-soft); } }
  .scripture .verse .lex { cursor: pointer; }

  .mkshare {
    position: fixed; left: 50%; transform: translateX(-50%); bottom: 1rem; z-index: 85;
    display: flex; align-items: center; gap: 8px;
    background: var(--ink); color: var(--paper);
    padding: 8px 10px 8px 14px; border-radius: 12px;
    box-shadow: 0 8px 24px rgba(14, 42, 46, 0.28); max-width: min(92vw, 40rem);
  }
  .mkshare[hidden] { display: none; }
  body.has-tabbar .mkshare { bottom: calc(4.9rem + env(safe-area-inset-bottom)); }
  .mkshare-ref { font-family: var(--sans); font-size: 0.82rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mkshare-btn { font-family: var(--sans); font-size: 0.82rem; background: var(--water); color: #fff; border: none; border-radius: 8px; padding: 6px 12px; cursor: pointer; }
  .mkshare-x { background: none; border: none; color: var(--paper); cursor: pointer; display: grid; place-items: center; padding: 4px; opacity: 0.8; }

  /* Read-along: the panel currently being spoken by the audio. */
  .hero.mkseg-active, .scripture .unit.mkseg-active, details.cascade.mkseg-active {
    background: var(--light-soft); border-radius: 8px; box-shadow: inset 3px 0 0 var(--light);
    transition: background-color .3s ease;
  }
  details.cascade.mkseg-active { padding-left: 4px; }
</style>

<script>
  function initQuiz(root, onComplete, reveal) {
    if (!root) return;
    const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
    root.querySelectorAll('.quiz-options').forEach((group) => {
      Array.from(group.children).sort(() => Math.random() - 0.5).forEach((b) => group.appendChild(b));
      Array.from(group.children).forEach((b, i) => { const l = b.querySelector('.opt-letter'); if (l) l.textContent = letters[i] || ''; });
    });
    const total = root.querySelectorAll('.quiz-q').length;
    let answered = 0;
    let sum = 0;
    root.addEventListener('click', (e) => {
      const opt = e.target.closest('.quiz-opt');
      if (!opt) return;
      const q = opt.closest('.quiz-q');
      if (!q || q.dataset.answered === '1') return;
      q.dataset.answered = '1';
      const weight = Number(opt.dataset.weight);
      sum += weight;
      answered += 1;
      q.querySelectorAll('.quiz-opt').forEach((o) => {
        o.classList.add('locked');
        if (reveal) {
          const w = Number(o.dataset.weight);
          o.classList.add('w' + w);
          const badge = o.querySelector('.opt-badge');
          if (badge) badge.textContent = w + '%';
        }
      });
      opt.classList.add('chosen');
      if (reveal) {
        const fb = q.querySelector('.quiz-feedback');
        if (fb) { fb.textContent = weight + '%: ' + (opt.dataset.note || ''); fb.hidden = false; }
      }
      const scoreEl = root.querySelector('.quiz-score');
      const val = root.querySelector('.quiz-score-val');
      const meta = root.querySelector('.quiz-score-meta');
      const avg = Math.round(sum / answered);
      if (scoreEl && val) {
        scoreEl.hidden = false;
        val.textContent = avg;
        if (meta) meta.textContent = '(' + answered + ' of ' + total + ' answered)';
      }
      if (answered === total && typeof onComplete === 'function') onComplete(avg);
    });
  }

  let preScore = null;

  const metaEl = document.getElementById('study-meta');
  const meta = metaEl ? { slug: metaEl.dataset.slug, book: metaEl.dataset.book, title: metaEl.dataset.title } : {};

  function fmtDate(iso) {
    try { return new Date(iso).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }); }
    catch (e) { return iso; }
  }
  async function renderHistory() {
    if (!window.makorGetHistory || !meta.slug) return;
    const rows = await window.makorGetHistory(meta.slug);
    const wrap = document.getElementById('history');
    const list = document.getElementById('history-list');
    if (!wrap || !list) return;
    const posts = rows.filter((r) => r.phase === 'post');
    if (posts.length === 0) { wrap.hidden = true; return; }
    list.innerHTML = '';
    posts.forEach((r) => {
      const li = document.createElement('li');
      li.textContent = fmtDate(r.created_at) + ': ' + r.score + '%';
      list.appendChild(li);
    });
    wrap.hidden = false;
  }

  const pre = document.getElementById('pretest');
  const gate = document.getElementById('study-gate');
  const openBtn = document.getElementById('open-study');
  initQuiz(pre, async (avg) => {
    preScore = avg;
    if (openBtn) openBtn.hidden = false;
    if (window.makorSaveAttempt) {
      await window.makorSaveAttempt({ slug: meta.slug, book: meta.book, title: meta.title, phase: 'pre', score: avg });
      if (window.makorRefreshProgress) window.makorRefreshProgress();
    }
  }, false);
  if (openBtn && gate) {
    openBtn.addEventListener('click', () => {
      gate.hidden = false;
      openBtn.disabled = true;
      openBtn.textContent = 'Study opened below';
      gate.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  const post = document.getElementById('posttest');
  initQuiz(post, async (avg) => {
    const cmp = document.getElementById('compare');
    const preOut = document.getElementById('pre-out');
    const postOut = document.getElementById('post-out');
    const msg = document.getElementById('compare-msg');
    if (preOut) preOut.textContent = preScore == null ? '0' : preScore;
    if (postOut) postOut.textContent = avg;
    if (msg) {
      const delta = preScore == null ? 0 : avg - preScore;
      if (delta > 0) msg.textContent = 'You grew by ' + delta + ' points today. Keep going, and give thanks.';
      else if (delta === 0) msg.textContent = 'Steady. Sit with the passage again and let it deepen.';
      else msg.textContent = 'Scores can dip when questions make us think harder. Return to the passage and the study.';
    }
    if (cmp) { cmp.hidden = false; cmp.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    const saveNote = document.getElementById('compare-save');
    if (window.makorSaveAttempt) {
      const res = await window.makorSaveAttempt({ slug: meta.slug, book: meta.book, title: meta.title, phase: 'post', score: avg });
      if (res && res.skipped) {
        if (saveNote) saveNote.textContent = 'Sign in with Google, at the top of the page, to save this and track your growth over time.';
      } else {
        if (saveNote) saveNote.textContent = 'Saved to your account.';
        renderHistory();
        if (window.makorRefreshProgress) window.makorRefreshProgress();
      }
    }
  }, true);

  let gateInit = false;
  async function initGate() {
    if (gateInit || !window.makorAllAttempts || !meta.slug) return;
    const rows = await window.makorAllAttempts();
    const mine = rows.filter((r) => r.study_slug === meta.slug);
    if (mine.some((r) => r.phase === 'pre')) {
      gateInit = true;
      if (gate) gate.hidden = false;
      const preSec = document.getElementById('pretest');
      if (preSec) {
        const q = preSec.querySelector('.quiz'); if (q) q.remove();
        const sc = preSec.querySelector('.quiz-score'); if (sc) sc.remove();
        const ob = document.getElementById('open-study'); if (ob) ob.remove();
        const lastPre = [...mine].reverse().find((r) => r.phase === 'pre');
        preScore = lastPre ? lastPre.score : preScore;
        const note = document.createElement('p');
        note.className = 'assess-done';
        note.textContent = 'You have answered the first questions already' + (lastPre ? ' (first score ' + lastPre.score + '%)' : '') + '. The study is open below.';
        preSec.appendChild(note);
      }
    }
  }
  window.addEventListener('makor-auth', () => { renderHistory(); initGate(); });
  renderHistory();
  initGate();

  // Open all / close all (panels inside the study)
  const btn = document.getElementById('toggle-all');
  function panels() { return Array.from(document.querySelectorAll('details.cascade')); }
  function refresh() {
    if (!btn) return;
    const anyClosed = panels().some((p) => !p.open);
    btn.textContent = anyClosed ? 'Open all' : 'Close all';
  }
  if (btn) {
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const anyClosed = panels().some((p) => !p.open);
      panels().forEach((p) => { p.open = anyClosed; });
      refresh();
    });
    panels().forEach((p) => p.addEventListener('toggle', refresh));
    refresh();
  }

  // Per-panel Go deeper
  document.querySelectorAll('.go-deeper').forEach((b) => {
    b.addEventListener('click', () => {
      const adv = b.nextElementSibling;
      if (!adv || !adv.classList.contains('level-advanced')) return;
      const closed = adv.hasAttribute('hidden');
      if (closed) { adv.removeAttribute('hidden'); b.textContent = 'Show less'; }
      else { adv.setAttribute('hidden', ''); b.textContent = 'Go deeper'; }
    });
  });

  // Glossary: underline hard words in the study prose and pop a plain definition on tap
  const glossary = {
    "polemic": "A piece of writing that argues strongly against an opposing view. Genesis 1 quietly argues against the creation myths of the surrounding nations.",
    "toledot": "A Hebrew word meaning generations or account. The phrase 'these are the generations of' divides the book of Genesis into sections.",
    "hermeneutics": "The art of reading and interpreting a text rightly: asking what the author meant, and how that kind of writing should be read.",
    "typology": "The study of how earlier persons, events, or things in Scripture act as patterns or signposts pointing forward to Christ.",
    "canonical": "Having to do with the whole Bible as one book. The canonical view asks where a passage sits in the sweep of all Scripture.",
    "prescriptive": "Text that tells us what we should do, a command or pattern to follow, rather than text that simply describes what happened.",
    "descriptive": "Text that describes what happened, without necessarily commanding us to copy it.",
    "immanent": "Being present within and close to creation. God is immanent, near to all He has made.",
    "transcendent": "Being above and beyond creation. God is transcendent, greater than all He has made.",
    "cosmos": "The ordered universe. Genesis shows God turning a formless waste into an ordered cosmos.",
    "prologue": "An opening section that sets the scene for what follows. Genesis 1 is the prologue to the whole Bible.",
    "Torah": "The first five books of the Bible, also called the Law of Moses.",
    "expository": "Teaching or preaching that carefully explains what a passage actually says, working through it in order.",
    "allegorise": "To read hidden symbolic meanings into a text that the author did not intend. Makor avoids this.",
    "redemptive": "Having to do with God's work of rescuing and restoring His people through Christ."
  };
  function escapeRe(str) { return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
  function linkGlossary() {
    const containers = document.querySelectorAll('#study-gate .cascade-body');
    containers.forEach((container) => {
      Object.keys(glossary).forEach((term) => {
        const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
            const p = node.parentElement;
            if (!p) return NodeFilter.FILTER_REJECT;
            if (p.closest('button, a, .gloss, .lex, .gloss-pop, .lex-pop, .scripture, .quiz, .assess, .glossary')) return NodeFilter.FILTER_REJECT;
            return NodeFilter.FILTER_ACCEPT;
          },
        });
        const rx = new RegExp('\\b' + escapeRe(term) + '\\b', 'i');
        let node;
        while ((node = walker.nextNode())) {
          const m = node.nodeValue.match(rx);
          if (!m) continue;
          const idx = m.index;
          const before = node.nodeValue.slice(0, idx);
          const matchText = node.nodeValue.slice(idx, idx + m[0].length);
          const after = node.nodeValue.slice(idx + m[0].length);
          const frag = document.createDocumentFragment();
          if (before) frag.appendChild(document.createTextNode(before));
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'gloss';
          btn.textContent = matchText;
          const pop = document.createElement('span');
          pop.className = 'gloss-pop';
          pop.hidden = true;
          pop.textContent = glossary[term];
          frag.appendChild(btn);
          frag.appendChild(pop);
          if (after) frag.appendChild(document.createTextNode(after));
          node.parentNode.replaceChild(frag, node);
          break;
        }
      });
    });
  }
  linkGlossary();
  document.addEventListener('click', (e) => {
    const b = e.target.closest('.gloss');
    if (!b) return;
    const pop = b.nextElementSibling;
    if (!pop || !pop.classList.contains('gloss-pop')) return;
    if (pop.hasAttribute('hidden')) pop.removeAttribute('hidden');
    else pop.setAttribute('hidden', '');
  });

  // Verse sharing and deep links. Tap verses to select them; each toggles on
  // its own, so several can be held at once to share a whole passage. Share or
  // Copy gives the selected text in quotes with a range reference (first to
  // last) and a link back to this movement at that passage.
  (function () {
    const bar = document.getElementById('mkshare');
    const refEl = document.getElementById('mkshare-ref');
    const sel = new Set();

    const allVerses = () => Array.from(document.querySelectorAll('.scripture .verse'));
    const ordered = () => allVerses().filter((v) => sel.has(v));
    function coords(v) { const m = (v.id || '').match(/^v(\d+)-(\d+)$/); return m ? { ch: +m[1], n: +m[2] } : null; }
    function bookName(v) { return (v.dataset.vref || '').replace(/\s+\d+:\d+$/, ''); }
    function rangeRef(a, b) {
      const A = coords(a), B = coords(b), book = bookName(a);
      if (!A) return a.dataset.vref || '';
      if (!B || (A.ch === B.ch && A.n === B.n)) return book + ' ' + A.ch + ':' + A.n;
      if (A.ch === B.ch) return book + ' ' + A.ch + ':' + A.n + '-' + B.n;
      return book + ' ' + A.ch + ':' + A.n + '-' + B.ch + ':' + B.n;
    }
    function refresh() {
      const arr = ordered();
      if (!arr.length) { if (bar) bar.hidden = true; return; }
      if (refEl) refEl.textContent = rangeRef(arr[0], arr[arr.length - 1]);
      if (bar) bar.hidden = false;
    }
    function toggle(v) { if (sel.has(v)) { sel.delete(v); v.classList.remove('selected'); } else { sel.add(v); v.classList.add('selected'); } refresh(); }
    function clearAll() { sel.forEach((v) => v.classList.remove('selected')); sel.clear(); if (bar) bar.hidden = true; }

    document.addEventListener('click', (e) => {
      if (e.target.closest('.lex, .lex-pop, .gloss, .gloss-pop')) return;
      const v = e.target.closest('.scripture .verse');
      if (v) toggle(v);   // clicking elsewhere keeps the selection; Close clears it
    });

    function shareData() {
      const arr = ordered(); if (!arr.length) return null;
      const first = arr[0], last = arr[arr.length - 1];
      const body = arr.map((v) => (v.dataset.vtext || '').trim()).filter(Boolean).join(' ');
      const A = coords(first), B = coords(last);
      let anchor = first.id;
      if (A && B && (A.ch !== B.ch || A.n !== B.n)) anchor = first.id + '..' + B.ch + '-' + B.n;
      return { text: '“' + body + '”\n— ' + rangeRef(first, last), url: location.origin + location.pathname + '#' + anchor };
    }
    function flashBtn(btn, msg) { const o = btn.textContent; btn.textContent = msg; setTimeout(() => { btn.textContent = o; }, 1400); }
    async function copy(btn) {
      const d = shareData(); if (!d) return;
      try { await navigator.clipboard.writeText(d.text + '\n' + d.url); flashBtn(btn, 'Copied'); } catch (e) {}
    }
    const shareBtn = document.getElementById('mkshare-share');
    if (shareBtn) shareBtn.addEventListener('click', async () => {
      const d = shareData(); if (!d) return;
      if (navigator.share) { try { await navigator.share({ text: d.text, url: d.url }); } catch (e) {} }
      else copy(shareBtn);
    });
    const copyBtn = document.getElementById('mkshare-copy');
    if (copyBtn) copyBtn.addEventListener('click', () => copy(copyBtn));
    const closeBtn = document.getElementById('mkshare-close');
    if (closeBtn) closeBtn.addEventListener('click', clearAll);

    function openHash() {
      const m = (location.hash || '').match(/^#v(\d+)-(\d+)(?:\.\.(\d+)-(\d+))?$/);
      if (!m) return;
      const startEl = document.getElementById('v' + m[1] + '-' + m[2]);
      if (!startEl) return;
      clearAll();
      let endEl = startEl;
      if (m[3]) { const e = document.getElementById('v' + m[3] + '-' + m[4]); if (e) endEl = e; }
      const all = allVerses();
      let i0 = all.indexOf(startEl), i1 = all.indexOf(endEl);
      if (i0 > i1) { const t = i0; i0 = i1; i1 = t; }
      for (let i = i0; i <= i1; i++) { sel.add(all[i]); all[i].classList.add('selected'); all[i].classList.add('flash'); setTimeout(((el) => () => el.classList.remove('flash'))(all[i]), 1800); }
      refresh();
      startEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    window.addEventListener('load', openHash);
    window.addEventListener('hashchange', openHash);
  })();

  // Read-along: highlight and gently follow the panel the audio is speaking.
  (function () {
    const metaEl = document.getElementById('study-meta');
    const mySlug = metaEl ? metaEl.dataset.slug : null;
    const SEG_TITLE = {
      'teaching-context': 'Context',
      'teaching-hermeneutics': 'Reading it rightly',
      'teaching-originalLanguages': 'The original languages',
      'teaching-typology': 'Types and shadows',
      'teaching-christ': 'Christ as the point',
      'teaching-god': 'What we learn about God',
      'teaching-crossReferences': 'Cross references',
      'teaching-oneStory': 'The one story',
      'teaching-translationNotes': 'Translation notes',
      'questions': 'Questions for reflection',
    };
    let cur = null;
    function clear() { if (cur) { cur.classList.remove('mkseg-active'); cur = null; } }
    function segElement(seg) {
      if (!seg) return null;
      if (seg === 'intro') return document.querySelector('.hero');
      if (seg.indexOf('passage-') === 0) {
        const n = parseInt(seg.slice(8), 10);
        return document.querySelectorAll('.scripture .unit')[n - 1] || null;
      }
      const title = SEG_TITLE[seg];
      if (!title) return null;
      const t = Array.from(document.querySelectorAll('.cascade-title')).find((x) => x.textContent.trim() === title);
      return t ? t.closest('details.cascade') : null;
    }
    function inView(el) { const r = el.getBoundingClientRect(); return r.top >= 64 && r.bottom <= window.innerHeight - 40; }
    window.addEventListener('makor-audio-seg', (e) => {
      const d = e.detail || {};
      if (d.slug !== mySlug) { clear(); return; }   // audio has rolled to another study
      const el = segElement(d.seg);
      if (!el) { clear(); return; }
      if (el !== cur) {
        clear(); el.classList.add('mkseg-active'); cur = el;
        const det = el.closest ? (el.matches('details') ? el : el.closest('details.cascade')) : null;
        if (det && !det.open) det.open = true;       // open the panel so the read text shows
        if (d.playing && !inView(el)) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  })();
</script>
