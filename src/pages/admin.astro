---
import Base from '../layouts/Base.astro';
import { getAllStudies, bookSlug } from '../lib/studies.js';

// Story picker source: every committed study, as { slug (url path), ref, title, book }.
const stories = getAllStudies().map((s) => ({
  slug: bookSlug(s.book) + '/' + (s.section?.slug ?? ''),
  ref: s.section?.passageRef ?? '',
  title: s.section?.title ?? '',
  book: s.book ?? '',
}));
---
<Base title="Admin | Makor" description="Makor administration.">
  <section class="hero">
    <p class="eyebrow">Admin</p>
    <h1>Dashboard</h1>
    <p class="lead">Stats, the Sunday email, plans and groups, and people. Private to administrators.</p>
  </section>

  <p id="admin-status" class="rank-status">Loading...</p>

  <div id="admin-wrap" hidden>

    <!-- ===================== STATS ===================== -->
    <details class="acc" open>
      <summary class="acc-h">Stats <span class="acc-sub">traffic, participation, email, attribution</span></summary>
      <div class="acc-body">
        <div class="period" id="period">
          <span>Window:</span>
          <button data-days="7" class="on" type="button">7 days</button>
          <button data-days="30" type="button">30 days</button>
        </div>

        <h2 class="prog-h2">Site traffic</h2>
        <div class="stat-row">
          <div class="stat"><div class="stat-num" id="t-views">0</div><div class="stat-label">page views</div></div>
          <div class="stat"><div class="stat-num" id="t-sessions">0</div><div class="stat-label">visits (sessions)</div></div>
          <div class="stat"><div class="stat-num" id="t-anon">0%</div><div class="stat-label">visits without an account</div></div>
          <div class="stat"><div class="stat-num" id="t-signups">0</div><div class="stat-label">new sign-ups</div></div>
        </div>
        <div class="panel"><div class="panel-head">Page views per day <span class="legend2"><i class="sw sw-v"></i>views <i class="sw sw-s"></i>visits</span></div><div id="t-chart" class="bars"></div></div>

        <h2 class="prog-h2">Non-account participation</h2>
        <p class="muted-note">Readers using Makor without signing in. They can read every study; only signed-in readers save progress.</p>
        <div class="stat-row">
          <div class="stat"><div class="stat-num" id="p-anonsess">0</div><div class="stat-label">visits without account</div></div>
          <div class="stat"><div class="stat-num" id="p-anonviews">0</div><div class="stat-label">page views without account</div></div>
          <div class="stat"><div class="stat-num" id="p-authsess">0</div><div class="stat-label">visits signed in</div></div>
        </div>
        <div class="panel"><div class="panel-head">Most-read pages by visitors without an account</div><div id="p-pages" class="ranklist"></div></div>

        <h2 class="prog-h2">Email by campaign</h2>
        <p class="muted-note">Opens and clicks are tracked from the moment tracking was enabled, so earlier sends may show delivery only.</p>
        <div id="email-block"></div>

        <h2 class="prog-h2">What drove studies</h2>
        <div class="panel"><div class="panel-head">Studies completed per day</div><div id="a-chart" class="bars"></div></div>
        <div class="panel"><div class="panel-head">Studies completed within 48 hours of each campaign</div><div id="a-lift" class="ranklist"></div></div>
        <div class="panel"><div class="panel-head">Study links most clicked from email</div><div id="a-links" class="ranklist"></div></div>

        <h2 class="prog-h2">People</h2>
        <div class="stat-row">
          <div class="stat"><div class="stat-num" id="a-users">0</div><div class="stat-label">people signed up</div></div>
          <div class="stat"><div class="stat-num" id="a-active">0</div><div class="stat-label">active in last 7 days</div></div>
          <div class="stat"><div class="stat-num" id="a-studies">0</div><div class="stat-label">studies completed, all people</div></div>
        </div>
        <table class="rank-table">
          <thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Studies</th><th>Before</th><th>After</th><th>Last active</th></tr></thead>
          <tbody id="admin-body"></tbody>
        </table>
      </div>
    </details>

    <!-- ===================== SUNDAY EMAIL ===================== -->
    <details class="acc">
      <summary class="acc-h">Sunday email <span class="acc-sub">the story and feature going out this week</span></summary>
      <div class="acc-body">
        <p class="muted-note">Each card is one Sunday edition: the story it opens and the feature it highlights. Choose the next story and feature, generate the email, read the thinking, preview it, then approve and send.</p>

        <div class="newed">
          <div class="newed-head">Plan the next edition</div>
          <div class="newed-grid">
            <label class="fld">
              <span>Story to focus on (optional)</span>
              <input id="ne-story" list="story-list" type="text" placeholder="Search by title or reference" autocomplete="off" />
              <input id="ne-story-slug" type="hidden" />
              <input id="ne-story-ref" type="hidden" />
            </label>
            <label class="fld">
              <span>Feature to highlight (optional)</span>
              <input id="ne-feature" list="feature-list" type="text" placeholder="e.g. Live in the Word reading plan" autocomplete="off" />
            </label>
          </div>
          <label class="fld">
            <span>Instruction (required)</span>
            <textarea id="ne-instruction" rows="3" placeholder="What to draw out, the tone, anything specific. Editions go out in this order, one each Sunday."></textarea>
          </label>
          <div class="newed-actions">
            <button id="ne-save" class="btn" type="button">Save draft</button>
            <button id="ne-gen" class="btn btn-primary" type="button">Save and generate</button>
            <span id="ne-msg" class="ne-msg"></span>
          </div>
        </div>

        <div id="editions" class="cards"></div>

        <h2 class="prog-h2">Emails that have gone out</h2>
        <p class="muted-note">Your weekly sequence and any editions already sent. Open one to read the exact email.</p>
        <div id="history" class="cards"></div>
      </div>
    </details>

    <!-- ===================== PLANS AND GROUPS ===================== -->
    <details class="acc">
      <summary class="acc-h">Plans and groups <span class="acc-sub">reading plans, group members, and errors</span></summary>
      <div class="acc-body">
        <div class="stat-row">
          <div class="stat"><div class="stat-num" id="pl-total">0</div><div class="stat-label">reading plans</div></div>
          <div class="stat"><div class="stat-num" id="pl-group">0</div><div class="stat-label">group plans</div></div>
          <div class="stat"><div class="stat-num" id="pl-solo">0</div><div class="stat-label">solo plans</div></div>
          <div class="stat"><div class="stat-num" id="pl-members">0</div><div class="stat-label">members invited</div></div>
          <div class="stat"><div class="stat-num" id="pl-accepted">0</div><div class="stat-label">members reading</div></div>
          <div class="stat"><div class="stat-num" id="pl-pending">0</div><div class="stat-label">invites pending</div></div>
        </div>
        <h2 class="prog-h2">Error management</h2>
        <div class="panel"><div class="panel-head">Bounced or failed emails</div><div id="pl-bounced" class="ranklist"></div></div>
        <div class="panel"><div class="panel-head">Stuck invites, pending over a week</div><div id="pl-stuck" class="ranklist"></div></div>
        <div class="panel"><div class="panel-head">Plans with no one reading along yet</div><div id="pl-orphan" class="ranklist"></div></div>
        <div class="panel"><div class="panel-head">Send and delivery failures</div><div id="pl-fail" class="ranklist"></div></div>
      </div>
    </details>

    <!-- ===================== USERS ===================== -->
    <details class="acc">
      <summary class="acc-h">Users <span class="acc-sub">sign-ups, sharing, and invites</span></summary>
      <div class="acc-body">
        <div class="stat-row">
          <div class="stat"><div class="stat-num" id="us-total">0</div><div class="stat-label">users</div></div>
          <div class="stat"><div class="stat-num" id="us-active">0</div><div class="stat-label">active in last 7 days</div></div>
          <div class="stat"><div class="stat-num" id="us-shares">0</div><div class="stat-label">shares by users</div></div>
          <div class="stat"><div class="stat-num" id="us-invites">0</div><div class="stat-label">invites sent by users</div></div>
        </div>
        <p class="muted-note">Shares are counted from the moment share tracking went live, so this begins near zero and grows.</p>
        <table class="rank-table">
          <thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Studies</th><th>Shares</th><th>Friend invites</th><th>Group invites</th><th>Last active</th></tr></thead>
          <tbody id="users-body"></tbody>
        </table>
      </div>
    </details>

  </div>

  <!-- Preview modal for a generated edition -->
  <div id="pv" class="pv" hidden>
    <div class="pv-box">
      <div class="pv-head">
        <div>
          <div class="pv-subject" id="pv-subject"></div>
          <div class="pv-preview" id="pv-preview"></div>
        </div>
        <button class="pv-x" id="pv-close" type="button" aria-label="Close">Close</button>
      </div>
      <details class="pv-think"><summary>The thinking</summary><div id="pv-thinking" class="pv-thinking"></div></details>
      <iframe id="pv-frame" class="pv-frame" sandbox="" title="Email preview"></iframe>
      <div class="pv-actions">
        <button id="pv-approve" class="btn" type="button">Approve</button>
        <button id="pv-send" class="btn btn-primary" type="button">Send to all subscribers</button>
        <span id="pv-msg" class="ne-msg"></span>
      </div>
    </div>
  </div>

  <!-- Sequence email edit modal -->
  <div id="seq" class="pv" hidden>
    <div class="pv-box">
      <div class="pv-head">
        <div class="pv-subject">Edit sequence email</div>
        <button class="pv-x" id="seq-close" type="button" aria-label="Close">Close</button>
      </div>
      <label class="fld"><span>Subject</span><input id="seq-subject" type="text" /></label>
      <label class="fld"><span>Preview text</span><input id="seq-preview" type="text" /></label>
      <label class="fld"><span>HTML body</span><textarea id="seq-html" rows="10" style="font-family:monospace;font-size:0.8rem"></textarea></label>
      <label class="fld"><span>Plain text body</span><textarea id="seq-txt" rows="5"></textarea></label>
      <label class="fld" style="flex-direction:row;align-items:center;gap:0.5rem"><input id="seq-active" type="checkbox" style="width:auto" /><span>Active (sending is on)</span></label>
      <div class="pv-actions">
        <button id="seq-save" class="btn btn-primary" type="button">Save</button>
        <span id="seq-msg" class="ne-msg"></span>
      </div>
    </div>
  </div>

  <datalist id="story-list"></datalist>
  <datalist id="feature-list">
    <option value="Live in the Word reading plan"></option>
    <option value="Read the Bible together, group plans"></option>
    <option value="The daily scripture email"></option>
    <option value="Original languages, Hebrew and Greek"></option>
    <option value="Listen, the audio player"></option>
    <option value="Progress and badges"></option>
    <option value="Search across every study"></option>
  </datalist>

  <script id="story-data" type="application/json" set:html={JSON.stringify(stories)}></script>

  <a class="backlink" href="/">Back to all books</a>
</Base>

<style is:global>
  .acc { border: 1px solid var(--line); border-radius: 12px; margin: 0 0 1rem; background: var(--surface); overflow: hidden; }
  .acc > .acc-h { list-style: none; cursor: pointer; padding: 0.95rem 1.15rem; font-family: var(--sans); font-weight: 700; font-size: 1rem; color: var(--ink); display: flex; align-items: baseline; gap: 0.6rem; border-left: 3px solid var(--light); }
  .acc > .acc-h::-webkit-details-marker { display: none; }
  .acc > .acc-h::before { content: '+'; color: var(--water); font-weight: 700; width: 1ch; }
  .acc[open] > .acc-h::before { content: '\2212'; }
  .acc[open] > .acc-h { border-bottom: 1px solid var(--line); }
  .acc-sub { font-weight: 500; font-size: 0.82rem; color: var(--muted); }
  .acc-body { padding: 1rem 1.15rem 1.35rem; }

  .period { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1.25rem; font-family: var(--sans); font-size: 0.85rem; color: var(--muted); }
  .period button { font-family: var(--sans); font-size: 0.82rem; font-weight: 600; cursor: pointer; background: var(--surface); border: 1px solid var(--line); color: var(--muted); padding: 0.35rem 0.85rem; border-radius: 999px; }
  .period button.on { background: var(--water); color: #fff; border-color: var(--water); }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 1rem 1.25rem; margin: 0 0 1.5rem; }
  .panel-head { font-family: var(--sans); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.85rem; display: flex; justify-content: space-between; align-items: center; }
  .legend2 { font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--muted); }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; vertical-align: middle; margin: 0 0.25rem 0 0.6rem; }
  .sw-v { background: var(--water); } .sw-s { background: var(--light); }
  .bars { display: flex; align-items: flex-end; gap: 4px; height: 150px; }
  .bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; gap: 3px; }
  .bar-pair { display: flex; align-items: flex-end; gap: 2px; width: 100%; justify-content: center; flex: 1; }
  .bar { width: 42%; background: var(--water); border-radius: 3px 3px 0 0; min-height: 2px; }
  .bar.b2 { background: var(--light); }
  .bar-lbl { font-family: var(--sans); font-size: 0.62rem; color: var(--muted); white-space: nowrap; }
  .bars-empty, .list-empty { font-family: var(--sans); color: var(--muted); font-style: italic; font-size: 0.9rem; }
  .ranklist { display: flex; flex-direction: column; gap: 0.5rem; }
  .rankrow { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-bottom: 1px solid var(--line); padding-bottom: 0.45rem; }
  .rankrow:last-child { border-bottom: none; }
  .rankrow .k { font-family: var(--sans); font-size: 0.9rem; color: var(--ink); word-break: break-word; }
  .rankrow .v { font-family: var(--serif); font-weight: 600; color: var(--water); white-space: nowrap; }
  .camp { border: 1px solid var(--line); border-radius: 10px; padding: 0.9rem 1.1rem; margin-bottom: 0.85rem; background: var(--surface); }
  .camp-name { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; color: var(--ink); margin-bottom: 0.5rem; }
  .camp-stats { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-bottom: 0.5rem; }
  .camp-stat { font-family: var(--sans); }
  .camp-stat b { display: block; font-family: var(--serif); font-size: 1.3rem; color: var(--water); line-height: 1.1; }
  .camp-stat span { font-size: 0.72rem; color: var(--muted); }
  .camp-links { margin-top: 0.5rem; }
  .camp-links .lh { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.3rem; }

  /* New edition form */
  .newed { border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.2rem; margin: 0 0 1.35rem; background: var(--surface); }
  .newed-head { font-family: var(--sans); font-weight: 700; color: var(--ink); margin-bottom: 0.85rem; }
  .newed-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; }
  @media (max-width: 640px) { .newed-grid { grid-template-columns: 1fr; } }
  .fld { display: flex; flex-direction: column; gap: 0.3rem; font-family: var(--sans); font-size: 0.82rem; color: var(--muted); margin-bottom: 0.85rem; }
  .fld span { font-weight: 600; }
  .fld input, .fld textarea { font-family: var(--sans); font-size: 0.92rem; color: var(--ink); background: var(--paper, #fff); border: 1px solid var(--line); border-radius: 8px; padding: 0.5rem 0.65rem; }
  .newed-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .btn { font-family: var(--sans); font-size: 0.85rem; font-weight: 600; cursor: pointer; background: var(--surface); border: 1px solid var(--line); color: var(--ink); padding: 0.5rem 1rem; border-radius: 999px; }
  .btn-primary { background: var(--water); color: #fff; border-color: var(--water); }
  .btn[disabled] { opacity: 0.5; cursor: default; }
  .ne-msg { font-family: var(--sans); font-size: 0.82rem; color: var(--muted); }

  /* Edition cards */
  .cards { display: flex; flex-direction: column; gap: 0.85rem; }
  .ecard { border: 1px solid var(--line); border-radius: 12px; padding: 0.95rem 1.1rem; background: var(--surface); display: flex; gap: 0.9rem; align-items: flex-start; }
  .ecard-ord { display: flex; flex-direction: column; gap: 0.15rem; align-items: center; }
  .ecard-ord button { border: 1px solid var(--line); background: var(--surface); color: var(--muted); border-radius: 6px; cursor: pointer; width: 26px; height: 22px; line-height: 1; }
  .ecard-main { flex: 1; min-width: 0; }
  .ecard-title { font-family: var(--serif); font-size: 1.1rem; font-weight: 600; color: var(--ink); }
  .ecard-meta { font-family: var(--sans); font-size: 0.8rem; color: var(--muted); margin-top: 0.15rem; }
  .ecard-sub { font-family: var(--sans); font-size: 0.85rem; color: var(--ink); margin-top: 0.35rem; }
  .ecard-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.7rem; }
  .ecard-actions .btn { padding: 0.35rem 0.75rem; font-size: 0.8rem; }
  .st { font-family: var(--sans); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.15rem 0.5rem; border-radius: 999px; white-space: nowrap; }
  .st-draft { background: #eee; color: #555; }
  .st-generating { background: #fff4d6; color: #8a6d1a; }
  .st-generated { background: #dcefe8; color: #0F6C6C; }
  .st-approved { background: #d7ead7; color: #2f6b2f; }
  .st-scheduled { background: #e2e0f5; color: #4b3fa0; }
  .st-sent { background: #0F6C6C; color: #fff; }
  .st-error { background: #f6dada; color: #a33; }
  .ecard-err { font-family: var(--sans); font-size: 0.8rem; color: #a33; margin-top: 0.4rem; }

  /* Preview modal */
  .pv { position: fixed; inset: 0; background: rgba(14,42,46,0.55); display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 60; }
  .pv[hidden] { display: none; }
  .pv-box { background: var(--surface); border-radius: 14px; width: min(680px, 100%); max-height: 90vh; overflow: auto; padding: 1.1rem 1.2rem 1.3rem; }
  .pv-head { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .pv-subject { font-family: var(--serif); font-size: 1.25rem; font-weight: 600; color: var(--ink); }
  .pv-preview { font-family: var(--sans); font-size: 0.85rem; color: var(--muted); margin-top: 0.2rem; }
  .pv-x { background: none; border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem; cursor: pointer; font-family: var(--sans); font-size: 0.8rem; color: var(--muted); }
  .pv-think { margin: 0.8rem 0; font-family: var(--sans); font-size: 0.88rem; }
  .pv-think summary { cursor: pointer; font-weight: 600; color: var(--water); }
  .pv-thinking { white-space: pre-wrap; color: var(--ink); margin-top: 0.5rem; line-height: 1.5; }
  .pv-frame { width: 100%; height: 55vh; border: 1px solid var(--line); border-radius: 10px; background: #fff; margin-top: 0.4rem; }
  .pv-actions { display: flex; gap: 0.6rem; align-items: center; margin-top: 0.8rem; flex-wrap: wrap; }
</style>

<script>
  const ADMIN_EMAILS = ['luyanda@fleetly.co.za'];
  let currentDays = 7;
  let editionsCache = [];
  let historyCache = [];
  let pvId = null;

  const stories = (() => { try { return JSON.parse(document.getElementById('story-data').textContent || '[]'); } catch (e) { return []; } })();
  const storyByLabel = new Map();

  function fmt(iso) { if (!iso) return '-'; try { return new Date(iso).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }); } catch (e) { return '-'; } }
  function fmtDay(d) { try { return new Date(d + 'T00:00:00').toLocaleDateString(undefined, { day: 'numeric', month: 'short' }); } catch (e) { return d; } }
  function daysAgo(iso) { if (!iso) return Infinity; return (Date.now() - new Date(iso).getTime()) / 86400000; }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
  function shortLink(u) { try { const x = new URL(u); return x.pathname + (x.search || ''); } catch (e) { return u; } }

  function pairBars(el, rows, key1, key2, labelKey) {
    if (!rows || !rows.length) { el.innerHTML = '<div class="bars-empty">No data yet.</div>'; el.classList.remove('bars'); return; }
    el.classList.add('bars');
    let max = 1;
    rows.forEach((r) => { max = Math.max(max, r[key1] || 0, key2 ? (r[key2] || 0) : 0); });
    el.innerHTML = rows.map((r) => {
      const h1 = Math.round(((r[key1] || 0) / max) * 100);
      const h2 = key2 ? Math.round(((r[key2] || 0) / max) * 100) : 0;
      const title = (r[key1] || 0) + (key2 ? ' views, ' + (r[key2] || 0) + ' visits' : '');
      const b2 = key2 ? '<div class="bar b2" style="height:' + h2 + '%" title="' + title + '"></div>' : '';
      return '<div class="bar-col"><div class="bar-pair"><div class="bar" style="height:' + h1 + '%" title="' + title + '"></div>' + b2 + '</div><div class="bar-lbl">' + fmtDay(r[labelKey]) + '</div></div>';
    }).join('');
  }

  function rankList(el, rows, kfn, vfn, emptyMsg) {
    if (!rows || !rows.length) { el.innerHTML = '<div class="list-empty">' + esc(emptyMsg || 'No data yet.') + '</div>'; return; }
    el.innerHTML = rows.map((r) => '<div class="rankrow"><span class="k">' + esc(kfn(r)) + '</span><span class="v">' + esc(vfn(r)) + '</span></div>').join('');
  }

  function renderAnalytics(a) {
    if (!a || a.error) return;
    const p = a.participation || {};
    document.getElementById('t-views').textContent = String(p.total_pageviews || 0);
    document.getElementById('t-sessions').textContent = String(p.total_sessions || 0);
    const anonPct = p.total_sessions ? Math.round((p.anon_sessions / p.total_sessions) * 100) : 0;
    document.getElementById('t-anon').textContent = anonPct + '%';
    document.getElementById('t-signups').textContent = String(p.signups || 0);
    pairBars(document.getElementById('t-chart'), a.traffic, 'pageviews', 'sessions', 'd');
    document.getElementById('p-anonsess').textContent = String(p.anon_sessions || 0);
    document.getElementById('p-anonviews').textContent = String(p.anon_pageviews || 0);
    document.getElementById('p-authsess').textContent = String(p.auth_sessions || 0);
    rankList(document.getElementById('p-pages'), p.top_anon_pages, (r) => r.path, (r) => r.views + ' views', 'No anonymous page views recorded yet.');
    const eb = document.getElementById('email-block');
    if (!a.email || !a.email.length) { eb.innerHTML = '<div class="panel"><div class="list-empty">No email events yet. New sends will appear here.</div></div>'; }
    else {
      eb.innerHTML = a.email.map((c) => {
        const name = c.label || (c.campaign === 'transactional' ? 'Transactional (badge emails)' : c.campaign);
        const links = (c.top_links && c.top_links.length)
          ? '<div class="camp-links"><div class="lh">Links clicked</div>' + c.top_links.map((l) => '<div class="rankrow"><span class="k">' + esc(shortLink(l.link)) + '</span><span class="v">' + l.clicks + '</span></div>').join('') + '</div>'
          : '';
        return '<div class="camp"><div class="camp-name">' + esc(name) + '</div><div class="camp-stats">'
          + '<div class="camp-stat"><b>' + (c.delivered || 0) + '</b><span>delivered</span></div>'
          + '<div class="camp-stat"><b>' + (c.open_rate == null ? '-' : c.open_rate + '%') + '</b><span>open rate</span></div>'
          + '<div class="camp-stat"><b>' + (c.ctr == null ? '-' : c.ctr + '%') + '</b><span>click rate</span></div>'
          + '<div class="camp-stat"><b>' + (c.clicked || 0) + '</b><span>clicks</span></div>'
          + '</div>' + links + '</div>';
      }).join('');
    }
    const at = a.attribution || {};
    pairBars(document.getElementById('a-chart'), at.completions_daily, 'completed', null, 'd');
    rankList(document.getElementById('a-lift'), at.campaign_lift, (r) => (r.label || 'Campaign') + '  (' + fmt(r.sent_at) + ')', (r) => (r.completions_48h || 0) + ' completed', 'No campaigns sent yet.');
    rankList(document.getElementById('a-links'), at.top_email_study_links, (r) => shortLink(r.link), (r) => r.clicks + ' clicks', 'No study links clicked from email yet.');
  }

  function renderPeople(rows) {
    document.getElementById('a-users').textContent = String(rows.length);
    document.getElementById('a-active').textContent = String(rows.filter((r) => daysAgo(r.last_active) <= 7).length);
    document.getElementById('a-studies').textContent = String(rows.reduce((a, r) => a + (r.studies_done || 0), 0));
    const body = document.getElementById('admin-body');
    body.innerHTML = '';
    rows.forEach((r) => {
      const tr = document.createElement('tr');
      const cells = [r.name || '-', r.email || '-', fmt(r.joined), String(r.studies_done || 0), r.pre_avg == null ? '-' : r.pre_avg + '%', r.post_avg == null ? '-' : r.post_avg + '%', fmt(r.last_active)];
      cells.forEach((c, ci) => { const td = document.createElement('td'); td.textContent = c; if (ci === 0) td.className = 'rank-name'; tr.appendChild(td); });
      body.appendChild(tr);
    });
  }

  // ---------- Sunday email ----------
  function statusLabel(s) { return { draft: 'Draft', generating: 'Generating', generated: 'Generated', approved: 'Approved', scheduled: 'Scheduled', sent: 'Sent', error: 'Error' }[s] || s; }

  function renderEditions(rows) {
    editionsCache = rows || [];
    const el = document.getElementById('editions');
    if (!editionsCache.length) { el.innerHTML = '<div class="list-empty">No editions yet. Plan the next one above.</div>'; return; }
    el.innerHTML = editionsCache.map((e) => {
      const acts = [];
      if (e.status === 'draft' || e.status === 'error') acts.push('<button class="btn btn-primary" data-act="gen" data-id="' + e.id + '">Generate</button>');
      if (e.status === 'generating') acts.push('<button class="btn" disabled>Generating...</button>');
      if (['generated', 'approved', 'scheduled', 'sent'].indexOf(e.status) !== -1) acts.push('<button class="btn" data-act="preview" data-id="' + e.id + '">Preview</button>');
      if (['generated', 'approved', 'scheduled'].indexOf(e.status) !== -1) acts.push('<button class="btn btn-primary" data-act="send" data-id="' + e.id + '">Send</button>');
      if (['generated', 'approved', 'scheduled', 'sent', 'error'].indexOf(e.status) !== -1) acts.push('<button class="btn" data-act="regen" data-id="' + e.id + '">Regenerate</button>');
      if (e.status !== 'sent') acts.push('<button class="btn" data-act="del" data-id="' + e.id + '">Delete</button>');
      const err = e.error ? '<div class="ecard-err">' + esc(e.error) + '</div>' : '';
      const when = e.status === 'sent' && e.sent_at ? 'Sent ' + fmt(e.sent_at) : 'In the sequence queue';
      return '<div class="ecard">'
        + '<div class="ecard-ord"><button data-act="up" data-id="' + e.id + '" title="Move up">&uarr;</button><button data-act="down" data-id="' + e.id + '" title="Move down">&darr;</button></div>'
        + '<div class="ecard-main">'
        + '<div class="ecard-title">' + esc(e.story_title || e.subject || 'Untitled edition') + '</div>'
        + '<div class="ecard-meta">' + esc(e.story_ref || '') + (e.story_ref ? '  |  ' : '') + esc(when) + '</div>'
        + '<div class="ecard-sub">Feature: ' + esc(e.feature_label || e.feature_key || 'not set') + '</div>'
        + (e.subject ? '<div class="ecard-sub">Subject: ' + esc(e.subject) + '</div>' : '')
        + err
        + '<div class="ecard-actions">' + acts.join('') + '</div>'
        + '</div>'
        + '<div><span class="st st-' + e.status + '">' + statusLabel(e.status) + '</span></div>'
        + '</div>';
    }).join('');
  }

  async function loadEditions() {
    const { data, error } = await window.makorClient.rpc('admin_weekly_editions');
    if (error) { document.getElementById('editions').innerHTML = '<div class="list-empty">Could not load editions.</div>'; return; }
    renderEditions(data || []);
  }

  async function createEdition(generate) {
    const msg = document.getElementById('ne-msg');
    const label = document.getElementById('ne-story').value.trim();
    const picked = storyByLabel.get(label);
    const slug = picked ? picked.slug : (document.getElementById('ne-story-slug').value || '');
    const ref = picked ? picked.ref : (document.getElementById('ne-story-ref').value || '');
    const title = picked ? picked.title : label;
    const feature = document.getElementById('ne-feature').value.trim();
    const featureKey = feature.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const instruction = document.getElementById('ne-instruction').value.trim();
    if (!instruction) { msg.textContent = 'Write an instruction. It is required.'; return; }
    if (!title && !feature) { msg.textContent = 'Add a story to focus on or a feature to highlight. At least one is needed.'; return; }
    msg.textContent = 'Saving...';
    const { data: id, error } = await window.makorClient.rpc('admin_create_edition', {
      p_story_slug: slug, p_story_ref: ref, p_story_title: title,
      p_feature_key: featureKey, p_feature_label: feature, p_instruction: instruction, p_target_send_on: null,
    });
    if (error) { msg.textContent = 'Could not save. ' + (error.message || ''); return; }
    document.getElementById('ne-story').value = '';
    document.getElementById('ne-feature').value = '';
    document.getElementById('ne-instruction').value = '';
    msg.textContent = generate ? 'Saved. Generating...' : 'Saved.';
    await loadEditions();
    if (generate && id) { await generateEdition(id); msg.textContent = 'Generated. Open the card to preview.'; }
  }

  async function generateEdition(id) {
    const msg = document.getElementById('ne-msg');
    // Optimistic status so the card shows Generating.
    const row = editionsCache.find((e) => e.id === id); if (row) { row.status = 'generating'; renderEditions(editionsCache); }
    if (msg) msg.textContent = 'Generating...';
    try {
      const { data, error } = await window.makorClient.functions.invoke('generate-weekly-edition', { body: { edition_id: id } });
      if (error) { if (msg) msg.textContent = 'Generation call failed: ' + (error.message || 'request blocked'); }
      else if (data && data.ok === false) { if (msg) msg.textContent = 'Generation error: ' + (data.error || 'see the card'); }
      else if (msg) { msg.textContent = 'Done. Open the card to preview.'; }
    } catch (e) { if (msg) msg.textContent = 'Generation failed: ' + String(e); }
    await loadEditions();
  }

  async function sendEdition(id) {
    if (!confirm('Send this edition to every current subscriber now?')) return;
    const { data, error } = await window.makorClient.rpc('admin_send_edition', { p_id: id });
    if (error) { alert('Could not send. ' + (error.message || '')); return; }
    if (data && data.ok === false) { alert('Not sent: ' + (data.error || 'unknown')); return; }
    alert('Sent to ' + ((data && data.recipients) || 0) + ' subscribers.');
    await loadEditions();
  }

  async function moveEdition(id, dir) { await window.makorClient.rpc('admin_move_edition', { p_id: id, p_dir: dir }); await loadEditions(); }
  async function setStatus(id, status) { await window.makorClient.rpc('admin_set_edition_status', { p_id: id, p_status: status }); await loadEditions(); }
  async function deleteEdition(id) { if (!confirm('Delete this edition?')) return; await window.makorClient.rpc('admin_delete_edition', { p_id: id }); await loadEditions(); }

  function openPreview(id) {
    const e = editionsCache.find((x) => x.id === id); if (!e) return;
    pvId = id;
    document.getElementById('pv-subject').textContent = e.subject || '(no subject)';
    document.getElementById('pv-preview').textContent = e.preview_text || '';
    document.getElementById('pv-thinking').textContent = e.thinking || 'No thinking recorded.';
    const frame = document.getElementById('pv-frame');
    frame.srcdoc = e.html || '<p style="font-family:sans-serif;padding:1rem;color:#888">No email body yet.</p>';
    document.getElementById('pv-approve').style.display = (e.status === 'generated') ? '' : 'none';
    document.getElementById('pv-send').style.display = (['generated', 'approved', 'scheduled'].indexOf(e.status) !== -1) ? '' : 'none';
    document.getElementById('pv-msg').textContent = '';
    document.getElementById('pv').hidden = false;
  }
  function closePreview() { document.getElementById('pv').hidden = true; pvId = null; }

  // Read-only view of a historic email (no approve or send).
  function openReadonly(obj) {
    pvId = null;
    document.getElementById('pv-subject').textContent = obj.subject || '(no subject)';
    document.getElementById('pv-preview').textContent = obj.preview_text || '';
    document.getElementById('pv-thinking').textContent = obj.thinking || 'No thinking recorded for this email.';
    document.getElementById('pv-frame').srcdoc = obj.html || '<p style="font-family:sans-serif;padding:1rem;color:#888">No email body.</p>';
    document.getElementById('pv-approve').style.display = 'none';
    document.getElementById('pv-send').style.display = 'none';
    document.getElementById('pv-msg').textContent = '';
    document.getElementById('pv').hidden = false;
  }

  async function loadHistory() {
    const { data, error } = await window.makorClient.rpc('admin_sequence_emails');
    const seq = (error || !data) ? [] : data;
    const sentEditions = editionsCache.filter((e) => e.status === 'sent');
    historyCache = [];
    seq.forEach((s) => historyCache.push({
      kind: 'Sequence', step: s.step, active: s.active, txt: s.txt,
      subject: s.subject, preview_text: s.preview_text, html: s.html, thinking: '',
      meta: (s.cadence === 'weekly' ? 'Weekly' : (s.cadence || '')) + ', step ' + s.step + ', ' + (s.sent_count || 0) + ' sent' + (s.last_sent ? ', last ' + fmt(s.last_sent) : '') + (s.active ? '' : ', off'),
    }));
    sentEditions.forEach((e) => historyCache.push({
      kind: 'Edition', subject: e.subject || e.story_title, preview_text: e.preview_text, html: e.html, thinking: e.thinking,
      meta: 'Edition, sent ' + fmt(e.sent_at),
    }));
    renderHistory();
  }

  function renderHistory() {
    const el = document.getElementById('history');
    if (!historyCache.length) { el.innerHTML = '<div class="list-empty">Nothing has gone out yet.</div>'; return; }
    el.innerHTML = historyCache.map((h, i) => {
      let acts = '<button class="btn" data-hist="' + i + '">Read</button>';
      let ord = '';
      if (h.kind === 'Sequence') {
        ord = '<div class="ecard-ord"><button data-seqmove="up" data-step="' + h.step + '" title="Move up">&uarr;</button><button data-seqmove="down" data-step="' + h.step + '" title="Move down">&darr;</button></div>';
        acts += '<button class="btn" data-seqedit="' + i + '">Edit</button>'
          + '<button class="btn" data-seqregen="' + i + '">Regenerate</button>'
          + '<button class="btn" data-seqdel="' + h.step + '">Delete</button>';
      }
      const badge = h.kind === 'Sequence' ? (h.active ? 'Sequence' : 'Off') : 'Edition';
      const badgeClass = (h.kind === 'Sequence' && !h.active) ? 'st-draft' : 'st-sent';
      return '<div class="ecard">' + ord + '<div class="ecard-main">'
        + '<div class="ecard-title">' + esc(h.subject || '(no subject)') + '</div>'
        + '<div class="ecard-meta">' + esc(h.meta || '') + '</div>'
        + (h.preview_text ? '<div class="ecard-sub">' + esc(h.preview_text) + '</div>' : '')
        + '<div class="ecard-actions">' + acts + '</div>'
        + '</div><div><span class="st ' + badgeClass + '">' + esc(badge) + '</span></div></div>';
    }).join('');
  }

  // Sequence email edit modal.
  let seqEditIndex = null;
  function openSeqEdit(i) {
    const h = historyCache[i]; if (!h) return;
    seqEditIndex = i;
    document.getElementById('seq-subject').value = h.subject || '';
    document.getElementById('seq-preview').value = h.preview_text || '';
    document.getElementById('seq-html').value = h.html || '';
    document.getElementById('seq-txt').value = h.txt || '';
    document.getElementById('seq-active').checked = !!h.active;
    document.getElementById('seq-msg').textContent = '';
    document.getElementById('seq').hidden = false;
  }
  function closeSeqEdit() { document.getElementById('seq').hidden = true; seqEditIndex = null; }
  async function saveSeqEdit() {
    if (seqEditIndex === null) return;
    const h = historyCache[seqEditIndex]; if (!h) return;
    const msg = document.getElementById('seq-msg'); msg.textContent = 'Saving...';
    const { error } = await window.makorClient.rpc('admin_sequence_update', {
      p_step: h.step,
      p_subject: document.getElementById('seq-subject').value,
      p_preview: document.getElementById('seq-preview').value,
      p_html: document.getElementById('seq-html').value,
      p_txt: document.getElementById('seq-txt').value,
      p_active: document.getElementById('seq-active').checked,
    });
    if (error) { msg.textContent = 'Could not save. ' + (error.message || ''); return; }
    closeSeqEdit();
    await loadHistory();
  }
  async function regenSeq(i) {
    const h = historyCache[i]; if (!h) return;
    const instruction = window.prompt('How should this email be rewritten? Leave blank to just improve it within the discipline.', '');
    if (instruction === null) return;
    const el = document.getElementById('history');
    el.style.opacity = '0.5';
    try {
      const { data, error } = await window.makorClient.functions.invoke('regenerate-sequence-email', { body: { step: h.step, instruction } });
      if (error) alert('Regenerate failed: ' + (error.message || 'request blocked'));
      else if (data && data.ok === false) alert('Regenerate error: ' + (data.error || 'unknown'));
    } catch (e) { alert('Regenerate failed: ' + String(e)); }
    el.style.opacity = '';
    await loadHistory();
  }
  async function moveSeq(step, dir) { await window.makorClient.rpc('admin_sequence_move', { p_step: step, p_dir: dir }); await loadHistory(); }
  async function delSeq(step) {
    if (!confirm('Delete this sequence email? If it has already been sent, it cannot be deleted and you will be asked to turn it off instead.')) return;
    const { data, error } = await window.makorClient.rpc('admin_sequence_delete', { p_step: step });
    if (error) { alert('Could not delete. ' + (error.message || '')); return; }
    if (data && data.ok === false) { alert(data.error || 'Could not delete.'); return; }
    await loadHistory();
  }

  // ---------- Plans and groups ----------
  function renderPlans(j) {
    if (!j || j.error) return;
    document.getElementById('pl-total').textContent = String(j.total_plans || 0);
    document.getElementById('pl-group').textContent = String(j.group_plans || 0);
    document.getElementById('pl-solo').textContent = String(j.solo_plans || 0);
    document.getElementById('pl-members').textContent = String(j.total_members || 0);
    document.getElementById('pl-accepted').textContent = String(j.accepted_members || 0);
    document.getElementById('pl-pending').textContent = String(j.pending_members || 0);
    rankList(document.getElementById('pl-bounced'), j.err_bounced, (r) => r.recipient || 'unknown', (r) => fmt(r.created_at), 'No bounced or failed emails. Good.');
    rankList(document.getElementById('pl-stuck'), j.err_stuck_invites, (r) => (r.owner_name || 'A reader') + ' invited ' + (r.member_name || 'a reader'), (r) => 'since ' + fmt(r.joined_at), 'No invites are stuck. Good.');
    rankList(document.getElementById('pl-orphan'), j.err_orphan_plans, (r) => (r.owner_name || 'A reader') + "'s plan", (r) => 'updated ' + fmt(r.updated_at), 'Every plan has a reader. Good.');
    rankList(document.getElementById('pl-fail'), j.err_send_failures, (r) => (r.email_key || 'send') + ' step ' + (r.step == null ? '-' : r.step), (r) => (r.status || 'failed') + ' ' + fmt(r.sent_at), 'No send failures. Good.');
  }
  async function loadPlans() {
    const { data, error } = await window.makorClient.rpc('admin_plans_overview');
    if (!error) renderPlans(data || {});
  }

  // ---------- Users ----------
  function renderUsers(rows) {
    rows = rows || [];
    document.getElementById('us-total').textContent = String(rows.length);
    document.getElementById('us-active').textContent = String(rows.filter((r) => daysAgo(r.last_active) <= 7).length);
    document.getElementById('us-shares').textContent = String(rows.reduce((a, r) => a + Number(r.shares || 0), 0));
    document.getElementById('us-invites').textContent = String(rows.reduce((a, r) => a + Number(r.friend_invites || 0) + Number(r.group_invites || 0), 0));
    const body = document.getElementById('users-body');
    body.innerHTML = '';
    rows.forEach((r) => {
      const tr = document.createElement('tr');
      const cells = [r.name || '-', r.email || '-', fmt(r.joined), String(r.studies_done || 0), String(r.shares || 0), String(r.friend_invites || 0), String(r.group_invites || 0), fmt(r.last_active)];
      cells.forEach((c, ci) => { const td = document.createElement('td'); td.textContent = c; if (ci === 0) td.className = 'rank-name'; tr.appendChild(td); });
      body.appendChild(tr);
    });
  }
  async function loadUsers() {
    const { data, error } = await window.makorClient.rpc('admin_users_overview');
    if (!error) renderUsers(data || []);
  }

  async function loadAnalytics() {
    if (!window.makorAnalytics) return;
    const a = await window.makorAnalytics(currentDays);
    renderAnalytics(a);
  }

  async function loadAdmin() {
    const status = document.getElementById('admin-status');
    const wrap = document.getElementById('admin-wrap');
    if (!window.makorClient) return;
    const { data: u } = await window.makorClient.auth.getUser();
    if (!u || !u.user) { if (status) { status.hidden = false; status.textContent = 'Open the menu at the top and sign in.'; } if (wrap) wrap.hidden = true; return; }
    if (ADMIN_EMAILS.indexOf(u.user.email) === -1) { if (status) { status.hidden = false; status.textContent = 'This page is for administrators only.'; } if (wrap) wrap.hidden = true; return; }

    const rows = window.makorAdminOverview ? await window.makorAdminOverview() : [];
    if (rows && rows.error) { if (status) { status.hidden = false; status.textContent = 'Could not load the dashboard.'; } return; }
    renderPeople(rows);
    await Promise.all([loadAnalytics(), loadPlans(), loadUsers()]);
    await loadEditions();
    await loadHistory();
    if (status) status.hidden = true;
    if (wrap) wrap.hidden = false;
  }

  // Populate the story datalist and lookup map.
  (function initStories() {
    const dl = document.getElementById('story-list');
    if (!dl) return;
    const frag = document.createDocumentFragment();
    stories.forEach((s) => {
      const label = s.title + (s.ref ? ' (' + s.ref + ')' : '');
      storyByLabel.set(label, s);
      const opt = document.createElement('option'); opt.value = label; frag.appendChild(opt);
    });
    dl.appendChild(frag);
  })();

  // Wiring.
  document.getElementById('period').addEventListener('click', function (e) {
    const btn = e.target.closest('button'); if (!btn) return;
    Array.prototype.forEach.call(this.querySelectorAll('button'), (b) => b.classList.remove('on'));
    btn.classList.add('on'); currentDays = Number(btn.dataset.days) || 7; loadAnalytics();
  });

  document.getElementById('ne-save').addEventListener('click', () => createEdition(false));
  document.getElementById('ne-gen').addEventListener('click', () => createEdition(true));

  document.getElementById('editions').addEventListener('click', function (e) {
    const btn = e.target.closest('button[data-act]'); if (!btn) return;
    const id = Number(btn.dataset.id); const act = btn.dataset.act;
    if (act === 'gen' || act === 'regen') generateEdition(id);
    else if (act === 'preview') openPreview(id);
    else if (act === 'send') sendEdition(id);
    else if (act === 'up') moveEdition(id, -1);
    else if (act === 'down') moveEdition(id, 1);
    else if (act === 'del') deleteEdition(id);
  });

  document.getElementById('history').addEventListener('click', function (e) {
    const btn = e.target.closest('button'); if (!btn) return;
    if (btn.dataset.hist != null) { const h = historyCache[Number(btn.dataset.hist)]; if (h) openReadonly(h); }
    else if (btn.dataset.seqedit != null) openSeqEdit(Number(btn.dataset.seqedit));
    else if (btn.dataset.seqregen != null) regenSeq(Number(btn.dataset.seqregen));
    else if (btn.dataset.seqmove != null) moveSeq(Number(btn.dataset.step), btn.dataset.seqmove === 'up' ? -1 : 1);
    else if (btn.dataset.seqdel != null) delSeq(Number(btn.dataset.seqdel));
  });
  document.getElementById('seq-close').addEventListener('click', closeSeqEdit);
  document.getElementById('seq').addEventListener('click', (e) => { if (e.target.id === 'seq') closeSeqEdit(); });
  document.getElementById('seq-save').addEventListener('click', saveSeqEdit);

  document.getElementById('pv-close').addEventListener('click', closePreview);
  document.getElementById('pv').addEventListener('click', (e) => { if (e.target.id === 'pv') closePreview(); });
  document.getElementById('pv-approve').addEventListener('click', async () => { if (pvId) { await setStatus(pvId, 'approved'); document.getElementById('pv-msg').textContent = 'Approved.'; } });
  document.getElementById('pv-send').addEventListener('click', async () => { if (pvId) { await sendEdition(pvId); closePreview(); } });

  window.addEventListener('makor-auth', loadAdmin);
  loadAdmin();
</script>
